<!-- «Поиск по документам» on WPF (SearchPage.cs on WinForms). No texts here: they come from the code (L.T). -->
<UserControl x:Class="CompInfo.Wpf.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompInfo.Wpf">
    <UserControl.Resources>
        <!-- a found file, column by column: Windows icon, type, where (chips) and matches, name, fragment; open, folder -->
        <DataTemplate x:Key="IconCell">
            <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Path}"
                   Margin="0,10" />
        </DataTemplate>
        <DataTemplate x:Key="TypeCell">
            <TextBlock x:Name="Type" Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="WORD">
                    <Setter TargetName="Type" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="EXCEL">
                    <Setter TargetName="Type" Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="PPT">
                    <Setter TargetName="Type" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="WhereCell">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Tip}">
                <ContentPresenter Content="{Binding Chips}" />
                <TextBlock Text="{Binding Count}" VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NameCell">
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="FragmentCell">
            <TextBlock Text="{Binding Fragment}" ToolTip="{Binding Tip}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="ButtonsCell">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource RowIconButton}" Content="&#xE8A7;" Foreground="{DynamicResource Accent}"
                        ToolTip="{Binding OpenTip}" AutomationProperties.Name="{Binding OpenTip}" Click="Open_Click" />
                <Button Style="{StaticResource RowIconButton}" Content="&#xE838;" Foreground="{DynamicResource Folder}"
                        ToolTip="{Binding FolderTip}" AutomationProperties.Name="{Binding FolderTip}" Click="Folder_Click" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- the phrase, «Найти», «Остановить» -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="Phrase" Width="420" KeyDown="Phrase_KeyDown" TextChanged="Phrase_TextChanged" />
            <Button x:Name="FindButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Find_Click" />
            <Button x:Name="StopButton" Margin="8,0,0,0" Visibility="Collapsed" Click="Stop_Click" />
        </StackPanel>
        <!-- where: all disks or a folder; in the text of documents; in the Recycle Bin -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="WhereLabel" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Muted}" />
            <ComboBox x:Name="Where" Width="240" MaxDropDownHeight="300" />
            <Button x:Name="PickButton" Margin="8,0,0,0" Click="Pick_Click" />
            <CheckBox x:Name="Contents" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" />
            <CheckBox x:Name="Recycle" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0" />
        </WrapPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Style="{StaticResource ThinProgress}" Margin="0,0,0,8" Visibility="Hidden" />
        <local:StatusLine x:Name="Status" DockPanel.Dock="Top" Margin="0,0,0,10" />

        <Border Style="{StaticResource TableFrame}">
            <ListView x:Name="Hits" Style="{StaticResource GridTable}" VirtualizingPanel.IsVirtualizing="True"
                      MouseDoubleClick="Hits_MouseDoubleClick" KeyDown="Hits_KeyDown">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridTableHeader}">
                        <GridViewColumn Width="34" CellTemplate="{StaticResource IconCell}" />
                        <GridViewColumn x:Name="TypeColumn" CellTemplate="{StaticResource TypeCell}" />
                        <GridViewColumn x:Name="WhereColumn" Width="200" CellTemplate="{StaticResource WhereCell}" />
                        <GridViewColumn x:Name="FileColumn" local:TableColumns.Fill="2" CellTemplate="{StaticResource NameCell}" />
                        <GridViewColumn x:Name="FragmentColumn" local:TableColumns.Fill="3" CellTemplate="{StaticResource FragmentCell}" />
                        <GridViewColumn Width="76" CellTemplate="{StaticResource ButtonsCell}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>    </DockPanel>
</UserControl>
