<!-- «Кибербезопасность»: SUSpector and the section of the toolbox (SecurityPage.cs on WinForms before).
     The checks are SecurityAudit (app\src\Security.cs), the found files SecurityFiles (app\src\SecurityFiles.cs).
     No texts here: they come from the code (L.T). -->
<UserControl x:Class="CompInfo.Wpf.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompInfo.Wpf">
    <UserControl.Resources>
        <!-- a check, cell by cell: its state icon, its name, the result in the colour of the result -->
        <DataTemplate x:Key="CheckIconCell">
            <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,10" Foreground="{DynamicResource Accent}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Waiting">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Border}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Good">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Bad">
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="CheckNameCell">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Top" Margin="0,9,6,8" />
        </DataTemplate>
        <DataTemplate x:Key="CheckResultCell">
            <TextBlock x:Name="Result" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,9,4,8"
                       Foreground="{DynamicResource Accent}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Waiting">
                    <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Good">
                    <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                    <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Bad">
                    <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- a line of the details of a check that has no files -->
        <DataTemplate x:Key="LineTemplate">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12,8,10,8" />
        </DataTemplate>

        <!-- a found file, cell by cell: Windows icon, type, location chips, matches, name; open, folder, delete (or a lock) -->
        <DataTemplate x:Key="FileIconCell">
            <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10"
                   ToolTip="{Binding Path}" />
        </DataTemplate>
        <DataTemplate x:Key="FileTypeCell">
            <TextBlock x:Name="Type" Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource Warn}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="WORD">
                    <Setter TargetName="Type" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="EXCEL">
                    <Setter TargetName="Type" Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="TagsCell">
            <ContentPresenter Content="{Binding Chips}" VerticalAlignment="Center" ToolTip="{Binding ChipsTip}" Visibility="{Binding ChipsVisibility}" />
        </DataTemplate>
        <DataTemplate x:Key="MatchesCell">
            <ContentPresenter Content="{Binding MatchesBadge}" ToolTip="{Binding MatchesTip}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="FileNameCell">
            <!-- in the view by users the folders under the place go in a muted line under the name -->
            <StackPanel ToolTip="{Binding Path}" VerticalAlignment="Center" Margin="0,7,0,7">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Folder}" Visibility="{Binding FolderVisibility}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Muted}" Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FileButtonsCell">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource RowIconButton}" Content="&#xE8A7;" Foreground="{DynamicResource Accent}"
                        ToolTip="{Binding OpenTip}" AutomationProperties.Name="{Binding OpenTip}" Click="Open_Click" />
                <Button Style="{StaticResource RowIconButton}" Content="&#xE838;" Foreground="{DynamicResource Folder}"
                        ToolTip="{Binding FolderTip}" AutomationProperties.Name="{Binding FolderTip}" Click="Folder_Click" />
                <Button x:Name="Delete" Style="{StaticResource RowIconButton}" Content="&#xE74D;" Foreground="{DynamicResource Bad}"
                        ToolTip="{Binding DeleteTip}" AutomationProperties.Name="{Binding DeleteTip}" Click="Delete_Click" />
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- the files of SupraWeed are never deleted: a lock instead of the bin -->
                <DataTrigger Binding="{Binding Protected}" Value="True">
                    <Setter TargetName="Delete" Property="Content" Value="&#xE72E;" />
                    <Setter TargetName="Delete" Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter TargetName="Delete" Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- the view by users: a group row (a user or a disk, then a place in it) with its arrow, icon, name and the number
             of files in the colour of the most important one; the group is a PlaceGroup (Name of the CollectionViewGroup) -->
        <Style x:Key="PlaceGroupHead" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" Background="Transparent" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="Hover" Background="Transparent" />
                                <StackPanel Orientation="Horizontal" Margin="{Binding Name.Indent}" MinHeight="34">
                                    <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Width="16"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                    <TextBlock x:Name="Icon" Text="{Binding Name.Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Margin="4,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Folder}" />
                                    <TextBlock x:Name="Label" Text="{Binding Name.Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name.Hint}" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <ContentPresenter Content="{Binding Name.Badge}" ToolTip="{Binding Name.BadgeTip}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE76C;" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Name.Depth}" Value="1">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource HeaderBack}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name.Tone}" Value="Accent">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name.Tone}" Value="Bad">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Bad}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Name.Tone}" Value="Muted">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Muted}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaceGroup" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource PlaceGroupHead}" IsChecked="{Binding Name.Expanded, Mode=TwoWay}" />
                            <ItemsPresenter x:Name="Items" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Name.Expanded}" Value="False">
                                <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- one row: run, «scan documents», «disable OneDrive» (for the OneDrive check), the status, the layout switch -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RunButton" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Click="Run_Click" />
                <Button x:Name="StopButton" VerticalAlignment="Center" Visibility="Collapsed" Click="Stop_Click" />
            </StackPanel>
            <CheckBox x:Name="ScanDocuments" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Margin="14,0,4,0" />
            <Button x:Name="OneDriveButton" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"
                    Click="OneDrive_Click" />
            <local:StatusLine x:Name="Status" Grid.Column="3" VerticalAlignment="Center" Margin="16,0,12,0" />
            <!-- the found files as a list or by user and place (only while they are shown) -->
            <Border x:Name="FileViewSwitch" Grid.Column="4" Style="{StaticResource Segmented}" VerticalAlignment="Center" Margin="0,0,10,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ListMode" Style="{StaticResource Segment}" GroupName="FileView" Content="&#xE8FD;" Width="40"
                                 FontFamily="{StaticResource IconFont}" FontSize="16" Checked="FileView_Checked" />
                    <RadioButton x:Name="TreeMode" Style="{StaticResource Segment}" GroupName="FileView" Content="&#xE716;" Width="40"
                                 FontFamily="{StaticResource IconFont}" FontSize="16" Checked="FileView_Checked" />
                </StackPanel>
            </Border>
            <Border x:Name="LayoutSwitch" Grid.Column="5" Style="{StaticResource Segmented}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Bottom" Style="{StaticResource Segment}" GroupName="Layout" Content="&#xE90E;" Width="40"
                                 FontFamily="{StaticResource IconFont}" FontSize="16" Checked="Layout_Checked" />
                    <RadioButton x:Name="Right" Style="{StaticResource Segment}" GroupName="Layout" Content="&#xE90D;" Width="40"
                                 FontFamily="{StaticResource IconFont}" FontSize="16" Checked="Layout_Checked" />
                </StackPanel>
            </Border>
        </Grid>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Style="{StaticResource ThinProgress}" Margin="0,0,0,8" Visibility="Hidden" />

        <!-- the checks and the details: one under the other or side by side (ApplyLayout), the edge between them can be dragged -->
        <Grid x:Name="Split">
            <Border x:Name="ChecksFrame" Style="{StaticResource TableFrame}">
                <ListView x:Name="Checks" Style="{StaticResource GridTable}" SelectionMode="Single" SelectionChanged="Checks_SelectionChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridTableHeader}">
                            <GridViewColumn Width="34" CellTemplate="{StaticResource CheckIconCell}" />
                            <GridViewColumn x:Name="CheckColumn" CellTemplate="{StaticResource CheckNameCell}" />
                            <GridViewColumn x:Name="ResultColumn" local:TableColumns.Fill="1" CellTemplate="{StaticResource CheckResultCell}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
            <GridSplitter x:Name="Splitter" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" />

            <Border x:Name="DetailsFrame" Style="{StaticResource TableFrame}">
                <Grid>
                    <!-- details of a check without files -->
                    <Grid x:Name="TextDetails">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource TableHeader}">
                            <TextBlock x:Name="DetailsHeader" Height="34" Padding="12,9,0,0" />
                        </Border>
                        <ListBox x:Name="Lines" Grid.Row="1" Style="{StaticResource BareListBox}" ItemContainerStyle="{StaticResource TableRow}"
                                 ItemTemplate="{StaticResource LineTemplate}" />
                    </Grid>
                    <!-- found files -->
                    <Grid x:Name="FileDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="Files" Style="{StaticResource GridTable}" SelectionMode="Single"
                                  MouseDoubleClick="Files_MouseDoubleClick" KeyDown="Files_KeyDown">
                            <!-- used only in the view by users: the user (or disk), then the place in it -->
                            <ListView.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource PlaceGroup}" />
                                <GroupStyle ContainerStyle="{StaticResource PlaceGroup}" />
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource GridTableHeader}">
                                    <GridViewColumn Width="34" CellTemplate="{StaticResource FileIconCell}" />
                                    <GridViewColumn x:Name="TypeColumn" CellTemplate="{StaticResource FileTypeCell}" />
                                    <GridViewColumn x:Name="TagsColumn" CellTemplate="{StaticResource TagsCell}" />
                                    <GridViewColumn x:Name="MatchesColumn" CellTemplate="{StaticResource MatchesCell}" />
                                    <GridViewColumn x:Name="FileColumn" local:TableColumns.Fill="1" CellTemplate="{StaticResource FileNameCell}" />
                                    <GridViewColumn CellTemplate="{StaticResource FileButtonsCell}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <!-- «delete all found: bin · 3, downloads · 2 …»: only the tags that have files -->
                        <Border x:Name="BulkBar" Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                                Padding="10,8,6,4" Visibility="Collapsed">
                            <WrapPanel x:Name="BulkButtons" />
                        </Border>
                    </Grid>                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
