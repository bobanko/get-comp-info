<!-- «База устройств» on WPF (DatabasePage.cs on WinForms; the logic is DeviceList.cs). No texts here: they come from the code. -->
<UserControl x:Class="CompInfo.Wpf.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompInfo.Wpf">
    <UserControl.Resources>
        <!-- a record, cell by cell (Cell0…Cell8, the columns of DeviceList.Columns): name (semibold; yellow when not by the rules,
             red when repeated), IP and serial (mono; red when repeated), user, collected (green and bold during 7 days),
             pills of the cloud, ESET and inventory, the comment; this computer on the soft green (DeviceRowItem) -->
        <Style x:Key="DeviceRowItem" TargetType="ListViewItem" BasedOn="{StaticResource GridTableRow}">
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GoodBack}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Cell0">
            <TextBlock x:Name="Name" local:Marked.Text="{Binding Name}" ToolTip="{Binding NameTip}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NameState}" Value="Warn">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NameState}" Value="Bad">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Cell1">
            <TextBlock x:Name="Ip" local:Marked.Text="{Binding Ip}" ToolTip="{Binding IpTip}" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IpRepeated}" Value="True">
                    <Setter TargetName="Ip" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Cell2">
            <TextBlock x:Name="Serial" local:Marked.Text="{Binding Serial}" ToolTip="{Binding SerialTip}" FontFamily="{StaticResource MonoFont}"
                       FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SerialRepeated}" Value="True">
                    <Setter TargetName="Serial" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Cell3">
            <TextBlock local:Marked.Text="{Binding User}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="Cell4">
            <TextBlock x:Name="Collected" Text="{Binding Collected}" ToolTip="{Binding CollectedTip}" VerticalAlignment="Center" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Recent}" Value="True">
                    <Setter TargetName="Collected" Property="Foreground" Value="{DynamicResource Good}" />
                    <Setter TargetName="Collected" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Cell5">
            <Border Style="{StaticResource Pill}" Tag="{Binding CloudKind}">
                <TextBlock Text="{Binding CloudText}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Cell6">
            <Border Style="{StaticResource Pill}" Tag="{Binding EsetKind}">
                <TextBlock Text="{Binding EsetText}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Cell7">
            <Border Style="{StaticResource Pill}" Tag="{Binding InventoryKind}" ToolTip="{Binding InventoryTip}">
                <TextBlock Text="{Binding InventoryText}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="Cell8">
            <TextBlock local:Marked.Text="{Binding Comment}" ToolTip="{Binding CommentTip}" Foreground="{DynamicResource Muted}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>    </UserControl.Resources>

    <DockPanel>
        <!-- search, the three filters of the web device list, «Обновить», «Экспорт в CSV» -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="Search" Width="300" Margin="0,0,8,6" TextChanged="Search_TextChanged" />
            <ComboBox x:Name="EsetFilter" Margin="0,0,8,6" SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="InventoryFilter" Margin="0,0,8,6" SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="RepeatsFilter" Margin="0,0,8,6" SelectionChanged="Filter_Changed" />
            <Button x:Name="ReloadButton" Margin="0,0,8,6" Click="Reload_Click" />
            <Button x:Name="ExportButton" Margin="0,0,8,6" Click="Export_Click" />
        </WrapPanel>
        <local:StatusLine x:Name="Notes" DockPanel.Dock="Top" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" />
            <TextBlock x:Name="Legend" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>

        <Border Style="{StaticResource TableFrame}">
            <!-- the columns: BuildColumns (titles with the sort arrow; ESET and the comment are not sortable) -->
            <ListView x:Name="Table" Style="{StaticResource GridTable}" ItemContainerStyle="{StaticResource DeviceRowItem}" SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="False" MouseDoubleClick="Table_MouseDoubleClick" KeyDown="Table_KeyDown" />
        </Border>    </DockPanel>
</UserControl>
