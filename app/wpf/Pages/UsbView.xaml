<!-- «USB-накопители»: youSBee and the section of the toolbox. The logic is UsbList (app\src\UsbList.cs),
     tested in app	ests; the texts come from UsbRow / the code (L.T). -->
<UserControl x:Class="CompInfo.Wpf.UsbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompInfo.Wpf">
    <UserControl.Resources>
        <!-- «Копировать» in a row: blue; green with a check right after copying; plain for a removed drive;
             only the icon in a narrow window (Compact of the view). -->
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="{Binding CopyWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource FieldBack}" />
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Copied}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Good}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="MinWidth" Value="36" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- a row: the soft red of a removed drive, the soft green of a new one fading out, a subtle fill under the mouse,
             the chosen row with a short blue bar on the left; a thin line under every row -->
        <Style x:Key="UsbRowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Line" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="Back" Background="Transparent" />
                                <Border x:Name="Flash" Background="{DynamicResource GoodBack}" Opacity="0" />
                                <Border x:Name="Hover" Background="Transparent" />
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource BadBack}" />
                                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Arrived}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="1" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleHover}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The columns: icon, drive letter, name, size, serial number (takes the free width), «Копировать».
             The header uses the same groups, so its titles stand over their columns. -->
        <DataTemplate x:Key="UsbRowTemplate">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Disk" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Copy" />
                </Grid.ColumnDefinitions>
                <!-- a flash drive; removed: grey with a red cross on a ring of the row colour -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding IconTip}">
                    <TextBlock x:Name="Drive" Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource Flash}" />
                    <Grid x:Name="Removed" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,-4,-1" Visibility="Collapsed">
                        <Ellipse Fill="{DynamicResource BadBack}" Margin="-1.5" />
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource Bad}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="Disk" Grid.Column="1" Text="{Binding DiskText}" ToolTip="{Binding DiskTip}"
                           VerticalAlignment="Center" Margin="8,0,12,0" />
                <TextBlock Grid.Column="2" Text="{Binding NameText}" ToolTip="{Binding NameTip}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="Serial" Grid.Column="4" Text="{Binding SerialText}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                           FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding SerialText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="Copy" Grid.Column="5" Style="{StaticResource CopyButton}" Margin="0,0,5,0"
                        ToolTip="{Binding CopyTip}" AutomationProperties.Name="{Binding CopyText}" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="CopyLabel" Text="{Binding CopyText}" VerticalAlignment="Center" Margin="8,0,0,1" />
                    </StackPanel>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Connected}" Value="False">
                    <Setter TargetName="Drive" Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter TargetName="Removed" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Disk" Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSerial}" Value="False">
                    <Setter TargetName="Serial" Property="Foreground" Value="{DynamicResource Warn}" />
                    <Setter TargetName="Serial" Property="FontFamily" Value="Segoe UI" />
                    <Setter TargetName="Serial" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Serial" Property="FontSize" Value="13.333" />
                    <Setter TargetName="Copy" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Copied}" Value="True">
                    <Setter TargetName="CopyIcon" Property="Text" Value="&#xE73E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="CopyLabel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- «Обновить» of the page (the toolbox); youSBee has it in the window header -->
        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" Click="Refresh_Click" />
        </StackPanel>
        <local:StatusLine x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" />

        <Border Style="{StaticResource TableFrame}">
            <Grid Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource TableHeader}">
                    <Grid Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Disk" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Size" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Copy" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DiskHeader" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0" />
                        <TextBlock x:Name="NameHeader" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SizeHeader" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                        <TextBlock x:Name="SerialHeader" Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <ListBox x:Name="Table" Grid.Row="1" Style="{StaticResource BareListBox}" ItemContainerStyle="{StaticResource UsbRowItem}"
                         ItemTemplate="{StaticResource UsbRowTemplate}" SelectionMode="Single"
                         MouseDoubleClick="Table_MouseDoubleClick" KeyDown="Table_KeyDown" />
                <!-- an empty table says what to do -->
                <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            IsHitTestVisible="False">
                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="{DynamicResource Border}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
