<Project Sdk="Microsoft.NET.Sdk">

  <!-- SUSpector on WPF (SUSPECTOR.md, WPF_MIGRATION.md). Runs on .NET Framework 4.8 of Windows without anything else;
       building needs the .NET SDK (tools\build.BAT finds it). No third-party packages.
       tools\build.BAT copies the result to bin\SUSpector.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SUSpector</AssemblyName>
    <RootNamespace>CompInfo.Wpf</RootNamespace>
    <ApplicationIcon>..\..\suspector.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Title, product, company, version and the target framework (4.8, as the WinForms programs: no 4.0 compatibility
         mode) come from obj\SuspectorVersion.cs, written by tools\build.BAT from app\SUSpector.version. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- no SUSpector.exe.config next to the exe: one file that works from a flash drive -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <!-- not used itself, but the XAML compiler loads it for System.Web.Extensions (JavaScriptSerializer of Json.cs) -->
    <Reference Include="System.Web" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
    <!-- only for the folder dialog of the document search (WPF on .NET Framework has none); part of .NET Framework -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- the core, shared with the WinForms programs and the tests (C# 5): SUSPECTOR_CORE of tools\build.BAT -->
  <ItemGroup>
    <Compile Include="..\..\..\obj\SuspectorVersion.cs" Link="Core\SuspectorVersion.cs" />
    <Compile Include="..\..\src\Json.cs" Link="Core\Json.cs" />
    <Compile Include="..\..\src\Store.cs" Link="Core\Store.cs" />
    <Compile Include="..\..\src\Identity.cs" Link="Core\Identity.cs" />
    <Compile Include="..\..\src\Machine.cs" Link="Core\Machine.cs" />
    <Compile Include="..\..\src\Network.cs" Link="Core\Network.cs" />
    <Compile Include="..\..\src\Shell.cs" Link="Core\Shell.cs" />
    <Compile Include="..\..\src\SystemChanges.cs" Link="Core\SystemChanges.cs" />
    <Compile Include="..\..\src\Security.cs" Link="Core\Security.cs" />
    <Compile Include="..\..\src\SecurityFiles.cs" Link="Core\SecurityFiles.cs" />
    <Compile Include="..\..\src\LooseSearch.cs" Link="Core\LooseSearch.cs" />
    <Compile Include="..\..\src\DocumentSearch.cs" Link="Core\DocumentSearch.cs" />
    <Compile Include="..\..\src\SuspectorUpdate.cs" Link="Core\SuspectorUpdate.cs" />
    <Compile Include="..\..\src\IniSettings.cs" Link="Core\IniSettings.cs" />
    <Compile Include="..\..\src\Lang.cs" Link="Core\Lang.cs" />
    <Compile Include="..\..\src\Strings.cs" Link="Core\Strings.cs" />
  </ItemGroup>

  <!-- the shared look of the WPF programs, the security page and the document search (also in the toolbox) -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Page Include="..\Shared\*.xaml" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Pages\Files.cs" Link="Pages\Files.cs" />
    <Compile Include="..\Pages\SecurityView.xaml.cs" Link="Pages\SecurityView.xaml.cs" />
    <Page Include="..\Pages\SecurityView.xaml" Link="Pages\SecurityView.xaml" />
    <Compile Include="..\Pages\SearchView.xaml.cs" Link="Pages\SearchView.xaml.cs" />
    <Page Include="..\Pages\SearchView.xaml" Link="Pages\SearchView.xaml" />
  </ItemGroup>

  <!-- the picture of «О программе»; the trigger words of the document check, under the name Security.cs reads -->
  <ItemGroup>
    <Resource Include="..\..\suspector.png" Link="suspector.png" />
    <EmbeddedResource Include="..\..\trigger-words.txt" LogicalName="CompInfo.trigger-words.txt" />
  </ItemGroup>

</Project>
