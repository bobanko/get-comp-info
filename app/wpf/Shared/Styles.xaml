<!-- Shared look of the WPF programs (youSBee now; SUSpector and comp-info later), in the manner of WinUI 3,
     with the colours of the web interface. Taken over from ..\SupraWeed\src\Wpf\Styles.xaml.
     Colours: WpfTheme.Apply puts the light or the dark set under these keys at the application level;
     everything uses them through DynamicResource, so a theme change repaints open windows at once.
     No texts here: they are set from the code through L.T (the translation check fails on a Cyrillic letter in XAML). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CompInfo.Wpf">
        <!-- the light set; WpfTheme.Apply replaces them before the first window -->
        <SolidColorBrush x:Key="WindowBack" Color="#F5F6F8" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HeaderBack" Color="#F0F2F5" />
        <SolidColorBrush x:Key="Text" Color="#1A1D21" />
        <SolidColorBrush x:Key="Muted" Color="#5D6673" />
        <SolidColorBrush x:Key="Border" Color="#DDE1E6" />
        <SolidColorBrush x:Key="Divider" Color="#E6E9ED" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHover" Color="#3B73ED" />
        <SolidColorBrush x:Key="AccentDown" Color="#1F54C8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8EFFF" />
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Good" Color="#16723A" />
        <SolidColorBrush x:Key="GoodBack" Color="#E3F5E9" />
        <SolidColorBrush x:Key="Warn" Color="#9A5B00" />
        <SolidColorBrush x:Key="WarnBack" Color="#FDF1DC" />
        <SolidColorBrush x:Key="Bad" Color="#B42318" />
        <SolidColorBrush x:Key="BadBack" Color="#FDECEB" />
        <SolidColorBrush x:Key="Flash" Color="#E87E04" />
        <SolidColorBrush x:Key="SubtleHover" Color="#0A000000" />
        <SolidColorBrush x:Key="SubtleDown" Color="#06000000" />
        <SolidColorBrush x:Key="FieldBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldHover" Color="#F0F2F5" />
        <SolidColorBrush x:Key="FieldDown" Color="#E6E9ED" />
        <SolidColorBrush x:Key="FieldFocus" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldBottom" Color="#8A9099" />
        <SolidColorBrush x:Key="FlyoutBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ScrollThumb" Color="#A3AAB4" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- technical values (IP, serial numbers), as the "mono" class of the web interface -->
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- The focus frame of WinUI 3: only when focus came from the keyboard (Tab), not after a click —
             WPF shows FocusVisualStyle exactly then. Two pixels in the text colour, just outside the control. -->
        <Style x:Key="FocusFrame">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource Text}"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A link button as WinUI 3 HyperlinkButton: blue text (and its icon inside the button), no frame;
             under the mouse the whole button area shows a subtle fill. Its padding is 11,5: put it with the left
             margin -11 so that the text stays in line with the text above. -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="11,5,11,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1"
                                BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleDown}" />
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- an icon of the icon font before the text of a button or a link -->
        <Style x:Key="ButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,8,0" />
        </Style>

        <!-- the main (blue) button: «Закрыть» of «О программе», «Копировать» -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentDown}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An ordinary button as WinUI 3 Button, with the colours of the web interface. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBack}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="12,5,12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldDown}" />
                                <Setter TargetName="Content" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A square button with one icon (the pin of youSBee). Tag = "on": switched on, a blue icon on the soft blue. -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A segmented switch (language and theme in «О программе»): a frame with the choices side by side,
             the chosen one blue. RadioButtons of one group inside a Border with the Segmented style. -->
        <Style x:Key="Segmented" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FieldBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A text field as WinUI 3 TextBox: rounded, a darker line at the bottom, blue line when typing. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBack}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <Border x:Name="Bottom" Height="1" VerticalAlignment="Bottom" Margin="5,0" Background="{DynamicResource FieldBottom}" />
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,6,6"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                            <!-- the hint of an empty field (the Tag of the text box, set from the code): «Слово или фраза» -->
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"
                                       Margin="12,0,10,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldFocus}" />
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bottom" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A password field (the key of the cloud): the look of the text field. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource FieldBack}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <Border x:Name="Bottom" Height="1" VerticalAlignment="Bottom" Margin="5,0" Background="{DynamicResource FieldBottom}" />
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,6,6"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldFocus}" />
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bottom" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the panel of a drop-down list: rounded, with a shadow -->
        <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black" />
        <Style x:Key="Flyout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FlyoutBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin" Value="8,2,8,12" />
            <Setter Property="Effect" Value="{StaticResource FlyoutShadow}" />
        </Style>

        <!-- A drop-down list as WinUI 3 ComboBox: the field of a button, a chevron on the right; the list in a rounded
             panel with a shadow, the chosen item with a short blue bar. -->
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Margin="-9,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource FieldBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="11,5,32,6" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{DynamicResource FieldBack}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="6">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" HorizontalOffset="-8"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Style="{StaticResource Flyout}" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- a text box without its own frame (selectable text of a dialog) -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- thin scroll bars that follow the theme -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Padding="2,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="Transparent" Padding="3,2">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                        </Track.Thumb>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- tooltips in the colours of the theme -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource FlyoutBack}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="6" Padding="9,5,9,7" MaxWidth="480">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A check box as in WinUI 3: a rounded square, blue with a tick when checked. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource FieldBottom}"
                                        Background="{DynamicResource FieldBack}" />
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter x:Name="Content" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Content" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small icon button inside a table row (open, folder, delete): no frame, a subtle fill under the mouse. -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleDown}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin progress line (WinUI 3 ProgressBar): the accent on a faint track; without a known share of the work
             (IsIndeterminate) a short piece of the accent runs along it. -->
        <Style x:Key="ThinProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1.5" HorizontalAlignment="Left" />
                            <Border x:Name="Running" Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Color="Transparent" Offset="0.3" />
                                        <GradientStop Color="Black" Offset="0.4" />
                                        <GradientStop Color="Black" Offset="0.6" />
                                        <GradientStop Color="Transparent" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Running" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Run">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Running" From="-0.7" To="0.7" Duration="0:0:1.6"
                                                             Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Run" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A choice of several (WinUI 3 RadioButton): a ring, blue with a white dot when chosen. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusFrame}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1" Stroke="{DynamicResource FieldBottom}" Fill="{DynamicResource FieldBack}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource FieldHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A table: a rounded frame on the surface colour, the header on the header colour (as the web tables);
             rows are items of a ListBox with the TableRow style. -->
        <Style x:Key="TableFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="TableHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="5,5,0,0" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
        <!-- A pill of the web interface (cloud status, ESET, inventory): Tag = "Good", "Warn", "Bad" or anything else (muted). -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1,8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource HeaderBack}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Good">
                    <Setter Property="Background" Value="{DynamicResource GoodBack}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Good}" />
                </Trigger>
                <Trigger Property="Tag" Value="Warn">
                    <Setter Property="Background" Value="{DynamicResource WarnBack}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Warn}" />
                </Trigger>
                <Trigger Property="Tag" Value="Bad">
                    <Setter Property="Background" Value="{DynamicResource BadBack}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Bad}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a column title that sorts the table: the header text, a subtle fill under the mouse -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="4,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a row of a table: a thin line under it, a subtle fill under the mouse, the chosen row with a short blue bar -->
        <Style x:Key="TableRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Line" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Border x:Name="Hover" Background="Transparent" />
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BareListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A table whose columns the user widens or narrows (the edge in the header) and drags to another place, as in
             SupraWeed (user's choice 21.11.2026): a ListView with a GridView in a TableFrame. The header band lies under
             the transparent column headers, so its corners stay rounded. TableColumns (Shared\Table.cs) fits the widths. -->
        <Style x:Key="GridTableHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="34" />
            <!-- as the cells: GridViewRowPresenter keeps 6 px on both sides of a cell -->
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="Box" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <!-- the edge to drag: the column gets wider or narrower (a thin line shows it under the mouse) -->
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="9" Margin="0,0,-4,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <Border x:Name="Edge" Width="1" Margin="0,8" Background="{DynamicResource Border}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Edge" Property="Background" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <!-- the empty rest of the header row: no edge, no hover -->
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Box" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <!-- the copy that follows the mouse while a column is dragged to another place -->
                            <Trigger Property="Role" Value="Floating">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- a row: the divider under it, a subtle fill under the mouse, the chosen one on the soft accent with a bar on the left;
             Background is free for a row of its own colour (this computer in the device database) -->
        <Style x:Key="GridTableRow" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Line" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Hover" Background="Transparent" />
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridTable" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GridTableRow}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="local:TableColumns.Fit" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Grid>
                            <Border Height="34" VerticalAlignment="Top" Background="{DynamicResource HeaderBack}" CornerRadius="5,5,0,0"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" />
                            <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
