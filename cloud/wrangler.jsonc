{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comp-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served only on the custom domain, which Cloudflare Access protects. workers.dev and
  // preview URLs stay off so Access cannot be bypassed through them.
  "routes": [{ "pattern": "comp-info.chagear.top", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comp-info",
      "database_id": "b3cd8108-feef-4afb-aab9-7329a365495e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access team domain.
    "ACCESS_TEAM_DOMAIN": "chagear.cloudflareaccess.com",
    // Application Audience (AUD) tag of the "Comp Info" Access application.
    "ACCESS_AUD": "8a6c4398ef16bc6b7f437a6fbd6d96b08c32570e93171d5d350ffe3a0994fa34",
    // Account and reusable Access policy ("Comp Info team") kept in step with active users.
    // Takes effect only when the CF_API_TOKEN secret is set.
    "CF_ACCOUNT_ID": "f5b670c0f2a1346c3bb65492495c4452",
    "ACCESS_POLICY_ID": "d8bf3622-bc8a-4deb-8b0c-48415594dcae",
    // Only GitHub Actions runs of this repository may publish program releases (OIDC).
    "RELEASE_REPOSITORY": "bobanko/get-comp-info"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
