{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comp-info",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comp-info",
      // Replace with the id printed by `npx wrangler d1 create comp-info`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access team domain, e.g. "my-team.cloudflareaccess.com".
    "ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application.
    "ACCESS_AUD": ""
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
